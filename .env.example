# ===========================================
# Server Environment Variables
# ===========================================

# MongoDB connection string (local for dev, Atlas for production)
MONGODB_URI=mongodb://localhost:27017/placement-feed

# Secret used to sign JWT tokens — use a long random string (min 32 chars)
JWT_SECRET=your-jwt-secret-here

# Admin credentials — the server auto-creates this admin on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Secret for signed cookies — use a long random string (min 32 chars)
COOKIE_SECRET=your-cookie-secret-here

# Set to "production" on Render
NODE_ENV=development

# Frontend URL — used for CORS origin and CSRF checks
# On Render, set this to your Vercel deployment URL (e.g. https://theplacementfeed.vercel.app)
CLIENT_URL=http://localhost:5173

# Optional: shared secret that Vercel adds to every request it proxies to the API (client/vercel.json).
# Set the SAME value as PROXY_SECRET in the Vercel project's environment variables. With it, rate
# limits count each visitor's own address instead of Vercel's. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PROXY_SECRET=

# Port the server listens on (Render sets this automatically)
PORT=5000

# Shared secret for the /api/cron/trigger HTTP endpoint.
# Set the same value in your external scheduler's Authorization header: Bearer <CRON_SECRET>
# Leave unset to disable the endpoint entirely.
CRON_SECRET=your-cron-secret-here

# Optional: temporary password given to a student when the admin resets their account.
# Valid for 72 hours and must be changed at the student's next login. Defaults to "college123".
# DEFAULT_STUDENT_PASSWORD=college123
